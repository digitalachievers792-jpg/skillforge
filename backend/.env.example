# ------------------------------------------------------------------
# SkillForge Backend Environment Variables
# Copy this file to .env and fill in real values. NEVER commit .env.
# ------------------------------------------------------------------

# Server
PORT=5000
NODE_ENV=development
# Frontend origin allowed by CORS (whitelist only this):
CLIENT_URL=http://localhost:5173

# MongoDB — local default, or paste your Atlas connection string
MONGODB_URI=mongodb://127.0.0.1:27017/skillforge

# JWT secrets — use long random strings in production
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Email (optional — verification/reset links are also logged to console
# and written to /backend/emails when no SMTP is configured)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="SkillForge <no-reply@skillforge.dev>"

# AI Mentor chatbot — any OpenAI-compatible endpoint.
# Leave OPENAI_API_KEY empty to use the built-in offline mentor.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Seed
SEED_ADMIN_EMAIL=admin@skillforge.dev
SEED_ADMIN_PASSWORD=Admin@123
